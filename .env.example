# Session
# Use a unique random value with at least 32 characters.
NUXT_SESSION_PASSWORD=

# Site access
# Scrypt hash compatible with nuxt-auth-utils hashPassword().
NUXT_SITE_PASSWORD_HASH=

# Discord OAuth
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=

# Discord authorization
NUXT_DISCORD_GUILD_ID=
NUXT_DISCORD_ROLE_ID=
NUXT_DISCORD_ROLE_RECHECK_SECONDS=900

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Alternative for Vercel OIDC authentication when no read-write token is used.
# BLOB_STORE_ID=
